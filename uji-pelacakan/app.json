{
  "expo": {
    "name": "Tridhata Uji Lacak",
    "slug": "tridhata-uji-pelacakan",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.tridhataagro.ujilacak",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikasi uji Tridhata mencatat lokasi selama uji coba berjalan, termasuk saat layar mati.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite"
    ]
  }
}
